<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script>
      /**
       * 주식 가격 유지 기간 계산 알고리즘
       * 전략: 단조 증가 스택(Monotonic Stack)을 활용한 선제적 정산
       */
      function solution(prices) {
        // arr: 가격 하락이 확인되지 않은 시점들을 보관하는 '대기소'(스택)
        const arr = [];
        // result: 최종 유지 시간을 저장할 대열 (미리 길이를 지정하여 효율 증대)
        const result = new Array(prices.length);

        for (let i = 0; i < prices.length; i++) {
          /**
           * [하락 포착 및 연쇄 정산]
           * 대기소에 병사가 있고, 마지막 병사의 가격이 현재 가격보다 높다면(하락 발생)
           * 조건이 만족하는 동안 과거의 병사들을 차례로 꺼내어 유지 시간을 기록합니다.
           */
          while (arr.length > 0 && arr[arr.length - 1].value > prices[i]) {
            const temp = arr.pop();
            // 유지 시간 = 현재 시점(i) - 대기소에 들어갔던 시점
            result[temp.index] = i - temp.index;
          }

          // 현재 시점의 정보를 대기소에 투입
          arr.push({ index: i, value: prices[i] });
        }

        /**
         * [잔적 소탕: 끝까지 가격이 떨어지지 않은 경우]
         * 루프가 끝났음에도 대기소에 남은 병사들은 마지막 순간까지 버틴 자들입니다.
         */
        while (arr.length > 0) {
          const temp = arr.pop();
          // 마지막 시점(prices.length - 1)을 기준으로 남은 시간을 정산
          result[temp.index] = prices.length - 1 - temp.index;
        }

        return result;
      }

      // 실행 예시: [1, 2, 3, 1, 2] -> 결과: [4, 3, 1, 1, 0]
      console.log(solution([1, 2, 3, 1, 2]));
    </script>
  </head>
  <body></body>
</html>
